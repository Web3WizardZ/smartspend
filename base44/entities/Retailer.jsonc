{
  "name": "Retailer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Retailer display name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Groceries",
        "Fuel",
        "Pharmacy",
        "Online Shopping",
        "Restaurants",
        "Clothing",
        "General Retail",
        "Travel"
      ],
      "description": "Primary category"
    },
    "subcategory": {
      "type": "string",
      "description": "Optional subcategory"
    },
    "logo_url": {
      "type": "string",
      "description": "URL to retailer logo"
    },
    "logo_alt_text": {
      "type": "string"
    },
    "brand_colour": {
      "type": "string",
      "description": "Hex colour for fallback"
    },
    "initials": {
      "type": "string",
      "description": "Fallback initials e.g. PnP"
    },
    "country": {
      "type": "string",
      "default": "ZA"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "category"
  ]
}
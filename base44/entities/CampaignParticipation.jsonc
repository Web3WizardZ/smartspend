{
  "name": "CampaignParticipation",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "joined",
        "in_progress",
        "completed",
        "reward_pending",
        "reward_claimed"
      ],
      "default": "joined"
    },
    "actions_completed": {
      "type": "number",
      "default": 0
    },
    "reward_eligibility": {
      "type": "string",
      "enum": [
        "not_eligible",
        "pending",
        "eligible",
        "claimed"
      ],
      "default": "not_eligible"
    },
    "g_reward_amount": {
      "type": "number",
      "default": 0
    },
    "completed_at": {
      "type": "string"
    },
    "last_milestone_notified_at": {
      "type": "string",
      "description": "ISO timestamp of the last milestone nudge email sent, used to debounce notifications"
    },
    "last_milestone_notified_count": {
      "type": "number",
      "description": "The actions_completed value at the time of the last notification, prevents duplicate sends for same milestone"
    }
  },
  "required": [
    "campaign_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
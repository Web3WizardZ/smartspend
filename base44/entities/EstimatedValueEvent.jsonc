{
  "name": "EstimatedValueEvent",
  "type": "object",
  "properties": {
    "recommendation_id": {
      "type": "string"
    },
    "retailer_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "estimated_value": {
      "type": "number"
    },
    "payment_profile_name": {
      "type": "string"
    },
    "loyalty_card_name": {
      "type": "string"
    },
    "user_confirmed_used": {
      "type": "boolean",
      "default": true
    },
    "g_reward_amount": {
      "type": "number",
      "default": 0,
      "description": "G$ earned from GoodDollar campaign rewards for this spend action"
    },
    "g_campaign_name": {
      "type": "string",
      "description": "The GoodDollar campaign that generated this G$ reward"
    },
    "g_reward_source": {
      "type": "string",
      "enum": [
        "campaign",
        "ubi_boost",
        "none"
      ],
      "default": "none",
      "description": "Source of the G$ reward"
    }
  },
  "required": [
    "amount",
    "estimated_value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}